<div class="comment top-margin">
  <%= component("user/avatar", user: comment.user, class: "comment-avatar") %>

  <div class="comment-inner">
    <div class="comment-header">

      <cite class="comment-meta">
        <%= link_to comment.user.name %>
      </cite>

      <%= component("utils/date_time", timestamp: comment.created_at) %>

      <div class="comment-actions">
        <% if comment.user == Current.user %>
          <%= link_to post_comment_path(comment.post, comment),
                      'data-turbo-method': :delete,
                      'data-turbo-confirm': 'Are you sure?',
                      class: 'confirmation' do %>
            <div class="clickable grey-fill standard-svg svg icon">
              <%= component('utils/inline_svg', path: 'icons/trash.svg') %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="comment-content">
      <p><%= comment.content %></p>
    </div>
  </div>
</div>
