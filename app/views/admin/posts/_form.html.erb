<%= form_with model: [:admin, record], class: 'form admin-form' do |form| %>
  <%= render 'layouts/common/errors', record: %>

  <div class="form-floating">
    <%= form.label :title %>
    <%= form.text_field :title, class: 'form-control', required: true, autofocus: true %>
  </div>

  <div class="flex admin-form-row">
    <div class="form-floating full-width">
      <%= form.label :user_id, 'Author' %>
      <%= form.collection_select :user_id, User.order(:username), :id, :username, {}, class: 'form-control' %>
    </div>

    <div class="form-floating full-width">
      <%= form.label :status %>
      <%= form.select :status, admin_enum_options(Post, :status), {}, class: 'form-control' %>
    </div>

    <div class="form-floating full-width">
      <%= form.label :published_at %>
      <%= form.datetime_local_field :published_at, class: 'form-control' %>
    </div>
  </div>

  <div class="form-floating">
    <%= form.label :content, 'Content (markdown)' %>
    <%= form.text_area :content, class: 'form-control form-textarea', rows: 16 %>
  </div>

  <div class="form-floating">
    <%= form.label :cover_image %>
    <%= form.file_field :cover_image, class: 'form-control', accept: 'image/*' %>
  </div>

  <fieldset class="admin-fieldset">
    <legend>Tags</legend>

    <div class="flex admin-checklist inline">
      <%= form.collection_check_boxes :tag_ids, Tag.order(:title), :id, :title do |box| %>
        <%= box.label(class: 'flex admin-check') { box.check_box + tag.span(box.text) } %>
      <% end %>
    </div>
  </fieldset>

  <%= render 'admin/resources/form_actions', form: %>
<% end %>
