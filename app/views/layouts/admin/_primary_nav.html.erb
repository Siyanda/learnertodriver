<nav role="navigation" class="admin dark-bg full-width flex spaced-between top-nav">

  <!-- menu - logo -->
  <div class="flex nav-area">
    <div class="flex center-aligned icon">
      <button type="button" class="padded mobile-only tablet-only menu light-fill standard-svg icon clear-btn" data-action="click->sidebar#toggle" aria-label="Toggle menu">
        <%= component('utils/inline_svg', path: 'icons/menu.svg') %>
      </button>

      <%= link_to admin_path, class: 'padded light-fill medium-svg icon', aria: { label: 'Admin dashboard' } do %>
        <%= component('utils/inline_svg', path: 'logo_icon.svg') %>
      <% end %>
    </div>
  </div>

  <!-- large screen nav -->
  <div class="flex nav-area">
    <div class="flex auto-marg navlist desktop-only">
      <%= link_to 'Dashboard', admin_path,           class: class_names('link', active: request.path == admin_path) %>
      <%= link_to 'Users',     admin_users_path,     class: "link #{url_contains?('active', admin_users_path)}" %>
      <%= link_to 'Quizzes',   admin_quizzes_path,   class: "link #{url_contains?('active', admin_quizzes_path)}" %>
      <%= link_to 'Questions', admin_questions_path, class: "link #{url_contains?('active', admin_questions_path)}" %>
      <%= link_to 'Posts',     admin_posts_path,     class: "link #{url_contains?('active', admin_posts_path)}" %>
    </div>
  </div>

  <div class="flex nav-area">
    <%= link_to 'View site', root_path, class: 'padded light-text' %>
  </div>

</nav>
