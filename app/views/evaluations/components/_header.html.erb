<div class="alt-border top-margin thick-tm content no-sides-margin">
  <div class="flex column">
    <div class="flex spaced-between">
      <div class="info">
        <%= content_tag(:h1, t('.title', title: quiz.title)) %>
        <h1><%= component('utils/date_time', timestamp: date.iso8601, format: :date) %></h1>
        <%= content_tag(:h2, pluralize(quiz.questions.count, t('.question'))) %>
        <%= content_tag(:h2, Current.user.name) %>
      </div>

      <div class="long-svg icon">
        <%= component('utils/inline_svg', path: 'logo.svg') %>
      </div>
    </div>
  </div>
</div>
