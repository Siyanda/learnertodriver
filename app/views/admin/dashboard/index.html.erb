<% title 'Admin' %>
<% breadcrumb :admin_root %>

<section class="admin-page">
  <header class="admin-page-header">
    <h1>Dashboard</h1>
  </header>

  <div class="stat-grid overview-cards">
    <%= component('utils/stat_card', label: 'Users',       value: @summary.counts[:users],       icon: 'icons/user.svg',        path: admin_users_path) %>
    <%= component('utils/stat_card', label: 'Quizzes',     value: @summary.counts[:quizzes],     icon: 'icons/performance.svg', path: admin_quizzes_path) %>
    <%= component('utils/stat_card', label: 'Questions',   value: @summary.counts[:questions],   icon: 'icons/chat-o.svg',      path: admin_questions_path) %>
    <%= component('utils/stat_card', label: 'Evaluations', value: @summary.counts[:evaluations], icon: 'icons/chart.svg',       path: admin_evaluations_path) %>
    <%= component('utils/stat_card', label: 'Posts',       value: @summary.counts[:posts],       icon: 'icons/newspaper-o.svg', path: admin_posts_path) %>
  </div>

  <div class="stat-grid overview-cards">
    <%= component('utils/stat_card', label: 'Completed evaluations', value: @summary.completed_evaluations) %>
    <%= component('utils/stat_card', label: 'Completion rate',       value: "#{@summary.completion_rate}%") %>
    <%= component('utils/stat_card', label: 'Average score',         value: "#{@summary.average_score}%") %>
  </div>

  <h2>Last 30 days</h2>

  <div class="stat-grid overview-cards activity-cards">
    <% activity, compared_to = @summary.activity, 'vs previous 30 days' %>
    <%= component('utils/stat_card', label: 'New users',             value: activity[:new_users].current,             change: activity[:new_users].change,             change_label: compared_to) %>
    <%= component('utils/stat_card', label: 'Evaluations started',   value: activity[:evaluations_started].current,   change: activity[:evaluations_started].change,   change_label: compared_to) %>
    <%= component('utils/stat_card', label: 'Evaluations completed', value: activity[:evaluations_completed].current, change: activity[:evaluations_completed].change, change_label: compared_to) %>
    <%= component('utils/stat_card', label: 'Comments',              value: activity[:comments].current,              change: activity[:comments].change,              change_label: compared_to) %>
  </div>

  <%= component('admin/storage_usage', modules: @summary.storage_modules, bytes: @summary.storage_bytes, files: @summary.storage_files) %>

  <div class="flex evenly-spaced panel">
    <div class="alt-border half-width content">
      <div class="padded">
        <div class="flex spaced-between center-aligned">
          <h2>Recent evaluations</h2>
          <%= link_to 'View all', admin_evaluations_path %>
        </div>

        <%= component('admin/table', records: @summary.recent_evaluations, columns: %i[user quiz status created_at], actions: []) %>
      </div>
    </div>

    <div class="alt-border half-width content">
      <div class="padded">
        <div class="flex spaced-between center-aligned">
          <h2>New users</h2>
          <%= link_to 'View all', admin_users_path %>
        </div>

        <%= component('admin/table', records: @summary.recent_users, columns: %i[username email_address created_at], actions: []) %>
      </div>
    </div>
  </div>
</section>
