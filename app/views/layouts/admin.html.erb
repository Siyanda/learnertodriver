<%= content_for(:body_controllers) { 'sidebar' } %>
<%= content_for(:classes_for_body) { 'admin-body' } %>
<%= content_for(:header)           { render 'layouts/admin/header' } %>
<%= content_for(:messages)         { render 'layouts/common/messages' } %>
<%= content_for(:body) do %>
  <div class="admin-shell">
    <%= render 'layouts/admin/side_menu_overlay' %>

    <main class="admin-main">
      <%= yield %>
    </main>
  </div>
<% end %>
<%= content_for(:footer) { render 'layouts/admin/footer' } %>

<%= render template: 'layouts/application' %>
