<% title t('.title') %>

<%= form_with url: confirmations_path do |form| %>
  <h1 class="text-center"><%= t('.title') %></h1>
  <p><%= t('.intro') %></p>

  <div class="form-floating">
    <%= form.label :email_address, t('.email_address') %>
    <%= form.email_field :email_address, class: 'form-control', required: true, autofocus: true, autocomplete: 'username', value: params[:email_address] %>
  </div>

  <br>
  <%= form.submit t('.submit'), class: 'rounded button btn-primary p-4 text-white' %>
<% end %>

<br>
<div class="mb-2">
  <%= link_to t('.sign_in'), new_session_path %>
</div>
