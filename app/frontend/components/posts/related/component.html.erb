<div class="padded section-heading">
  <div class="flex">
    <div class="sub-section dark-stroke sm-icon">
      <%= component('utils/inline_svg', path: 'icons/clock.svg') %>
    </div>
    <h3 class="sub-heading">Related Posts</h3>
  </div>
  <hr class="third-width hr-grey">
  <div class="section">
    <% post.related.published.each do |post| %>
      <div class="item">
          <%= link_to post.title, post, class: 'link' %>
      </div>
    <% end %>
  </div>
</div>
